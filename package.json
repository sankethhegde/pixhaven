{
  "name": "pixhaven",
  "productName": "PixHaven",
  "version": "0.6.1",
  "description": "Offline AI image upscaler",
  "author": "Sanketha R Hegade",
  "license": "UNLICENSED",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "setup:engine": "node scripts/setup-engine.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --test tests/*.test.mjs",
    "dist": "npm run typecheck && electron-vite build && electron-builder --win",
    "e2e": "electron-vite build && node scripts/run-e2e.mjs",
    "e2e:sort": "electron-vite build && node scripts/run-e2e.mjs tests/e2e-sort.mjs e2e-output/sort",
    "e2e:tidy": "electron-vite build && node scripts/run-e2e.mjs tests/e2e-tidy.mjs e2e-output/tidy",
    "e2e:library": "electron-vite build && node scripts/run-e2e.mjs tests/e2e-library.mjs e2e-output/library",
    "e2e:player": "electron-vite build && node scripts/run-e2e.mjs tests/e2e-player.mjs e2e-output/player",
    "e2e:tags": "electron-vite build && node scripts/run-e2e-tags.mjs",
    "e2e:watch": "electron-vite build && node scripts/run-e2e-watch.mjs",
    "test:scale": "node tests/index-scale.mjs",
    "release": "npm run typecheck && electron-vite build && electron-builder --win --publish always"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "electron-updater": "^6.8.9",
    "exifr": "^7.1.3",
    "onnxruntime-node": "^1.30.0",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "vite": "^7.3.7"
  },
  "allowScripts": {
    "electron@44.7.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
